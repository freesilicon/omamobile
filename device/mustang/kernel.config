# SPDX-License-Identifier: MIT
# Pixel 10 Pro XL (mustang, laguna) Stage 1 kernel config fragment.
# Merged on top of defconfig + kernel/configs/omamobile.config.

# CPM MBA mailbox, clock, reset, power-controller, and GIA interrupt aggregators
CONFIG_MAILBOX=y
CONFIG_GOOGLE_MBA_CTRL=y
CONFIG_GOOGLE_MBA_CPM_INTERFACE=y
CONFIG_GOOGLE_CPM_CLK=y
CONFIG_GOOGLE_CPM_RST=y
CONFIG_GOOGLE_POWER_CONTROLLER=y
CONFIG_GIA_LIB=y
CONFIG_GOOGLE_GIA_IRQ=y

# Laguna watchdogs and DesignWare 8250 UART console
CONFIG_GOOGLE_WDT=y
CONFIG_SERIAL_8250_DW=y

# USB2 DWC3 controller + Google USB PHY (initramfs USB NCM/ACM gadget)
CONFIG_PHY_GOOGLE_USB=y
CONFIG_USB_DWC3_GOOGLE=y
