/*
 * Minimal Pixel 10 Pro Fold (rango) board overlay for ABL.
 * Stock MP1.0 board selects board_id 0x70606, board_rev 0x10000 (dtbo entry 10).
 */
/dts-v1/;
/plugin/;

/ {
	board_id = <0x70606>;
	board_rev = <0x10000>;

	fragment@0 {
		target-path = "/";
		__overlay__ {
		};
	};
};
