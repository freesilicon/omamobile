# SPDX-License-Identifier: MIT
# Omamobile storage guard for Pixel 10 Pro Fold (rango), continued in Arch.
# The initramfs marks every UFS partition read-only except slot B's boot
# images and userdata, leaves UFS_RW_LUNS unset so sdb/sdc/sdd and LUN4 sde
# (zoned_device) stay read-only at the disk level, and removes /dev/sda.
# udev would recreate /dev/sda, so make the whole-disk node inaccessible and
# keep desktop tools from touching any Android partition or zoned LUN.
SUBSYSTEM=="block", KERNEL=="sda", MODE="0000", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", KERNEL=="sd[b-e]", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", KERNEL=="sd[a-e][0-9]*", ENV{ID_PART_ENTRY_NAME}!="userdata", ENV{UDISKS_IGNORE}="1"
